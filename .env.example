# Copiar para .env e preencher. Só chaves PÚBLICAS aqui (EXPO_PUBLIC_ vai para o browser).
# A chave secreta/service role NUNCA entra neste ficheiro: só em Edge Functions.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Analytics (PostHog, opcional; só envia com consentimento). Chave pública do projeto.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Contacto mostrado nas páginas legais (opcional)
EXPO_PUBLIC_CONTACT_EMAIL=
